# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.data/
.shots/

.vercel
.env*

# playwright
/e2e/.auth/
/test-results/
/playwright-report/

# source material for imports (never committed)
/_import/

# Cloudflare build output + local secrets (also ignored on the cloudflare-migration branch)
/.open-next/
/.wrangler/
.dev.vars*
!.dev.vars.example
/e2e/.state/
*.key
supabase/.temp/
# internal working notes (kept locally; not published)
/NOTES.md

# student rosters (names and IDs of minors): never commit
*.csv
roster*.json

# raw Lighthouse reports (large; contain page config): summaries and timing tables are committed
docs/lighthouse/*/*-mobile.json
docs/lighthouse/*/*-desktop.json
