# ==========================================================================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง (.env.local ไม่ถูก commit)
# บนโฮสต์ (เช่น Vercel): Project → Settings → Environment Variables ใส่ชื่อ/ค่าเดียวกัน แล้ว Redeploy
# ดูสถานะทุกค่าได้ที่ /admin/setup (เฉพาะ admin, แสดงแค่สถานะ ไม่แสดงค่า)
# ไฟล์นี้สร้างจาก lib/env-spec.ts + messages/th.json ด้วย `npm run env:docs` — แก้ที่ต้นทางแล้วรันใหม่
# ==========================================================================================

# --- APP_SECRET (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: กุญแจลับของแอป ใช้เซ็นโทเคน API อายุสั้น และเป็นเกลือ (salt) ตอนแปลง IP เป็นค่าแฮช
# หาจากไหน: สร้างเอง: รันคำสั่ง node -e "console.log(require('crypto').randomBytes(32).toString('base64'))" แล้วคัดลอกผลลัพธ์มาใส่ (อย่างน้อย 32 ตัวอักษร)
# ลิงก์: https://nodejs.org/api/crypto.html#cryptorandombytessize-callback
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ใช้คีย์ชั่วคราวสำหรับ dev | production → สร้างโทเคน API และบันทึกข้อความส่งเสียงถึงสภาไม่ได้ (error)
APP_SECRET=

# --- NEXT_PUBLIC_SITE_URL (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: ที่อยู่เว็บจริง ใช้ทำ sitemap, ลิงก์ hreflang และ Open Graph
# หาจากไหน: โดเมนของเว็บที่ deploy แล้ว เช่น https://council.utd.ac.th (Vercel → Project → Settings → Domains) ไม่ต้องมี / ท้าย — ควรเป็น https://utdsc.com (โดเมนหลัก) ค่าอื่นจะขึ้นเตือน
# ลิงก์: https://vercel.com/docs/projects/domains
# เปิดเผย: เปิดเผยได้ (ค่านี้ถูกส่งไปถึงเบราว์เซอร์)
# ถ้าไม่ใส่: dev → ใช้ http://localhost:3000 | production → ลิงก์ใน sitemap/แชร์ชี้ไป localhost — ผิด
NEXT_PUBLIC_SITE_URL=https://council.example.ac.th

# --- NEXT_PUBLIC_SUPABASE_URL (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: ที่อยู่โปรเจกต์ Supabase (ฐานข้อมูล + ระบบล็อกอิน + เก็บรูป)
# หาจากไหน: supabase.com → เลือกโปรเจกต์ → Project Settings → Data API → Project URL (รูปแบบ https://xxxx.supabase.co ไม่มี /rest/v1)
# ลิงก์: https://supabase.com/dashboard/project/_/settings/api
# เปิดเผย: เปิดเผยได้ (ค่านี้ถูกส่งไปถึงเบราว์เซอร์)
# ถ้าไม่ใส่: dev → เว็บใช้ข้อมูลตัวอย่างจาก content/seed.json, หลังบ้านเข้าไม่ได้ | production → ไม่มีข้อมูลจริง, ล็อกอินไม่ได้
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# --- NEXT_PUBLIC_SUPABASE_ANON_KEY (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: คีย์สาธารณะของ Supabase ใช้อ่านข้อมูลที่อนุมัติแล้ว (ถูกจำกัดด้วย RLS)
# หาจากไหน: supabase.com → Project Settings → API Keys → Publishable key (หรือแท็บ Legacy → anon public)
# ลิงก์: https://supabase.com/dashboard/project/_/settings/api-keys
# เปิดเผย: เปิดเผยได้ (ค่านี้ถูกส่งไปถึงเบราว์เซอร์)
# ถ้าไม่ใส่: dev → เหมือนกรณีไม่มี SUPABASE_URL | production → ไม่มีข้อมูลจริง, ล็อกอินไม่ได้
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- SUPABASE_SERVICE_ROLE_KEY (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: คีย์สิทธิ์สูงสุดของ Supabase (ข้าม RLS) ใช้เฉพาะฝั่งเซิร์ฟเวอร์หลังตรวจสิทธิ์แล้ว: อนุมัติ, อัปโหลดรูป, บันทึกข้อความส่งเสียง
# หาจากไหน: supabase.com → Project Settings → API Keys → Secret key (หรือแท็บ Legacy → service_role) — ห้ามใส่ในโค้ดฝั่งหน้าเว็บเด็ดขาด
# ลิงก์: https://supabase.com/dashboard/project/_/settings/api-keys
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ข้อความ /voice เก็บลงไฟล์ .data/voice.jsonl, หลังบ้านอนุมัติ/อัปโหลดไม่ได้ | production → ส่งเสียงถึงสภาไม่ได้ (ปฏิเสธ), หลังบ้านใช้ไม่ได้
SUPABASE_SERVICE_ROLE_KEY=

# --- UPSTASH_REDIS_REST_URL (ไม่บังคับ) ---
# ใช้ทำอะไร: ที่อยู่ Redis สำหรับจำกัดจำนวนคำขอ (rate limit) และรายการ IP ที่ถูกแบน ให้ใช้ร่วมกันทุกเซิร์ฟเวอร์
# หาจากไหน: upstash.com → Redis → Create Database → หน้า Database → แท็บ REST API → UPSTASH_REDIS_REST_URL (ขึ้นต้น https:// ไม่ใช่ rediss://)
# ลิงก์: https://console.upstash.com/redis
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ใช้ตัวจำกัดในหน่วยความจำ (พอสำหรับเครื่องเดียว) | production → จำกัดคำขอแยกกันแต่ละเซิร์ฟเวอร์ — กันบอทได้น้อยลง
UPSTASH_REDIS_REST_URL=https://xxxx-xxxx-12345.upstash.io

# --- UPSTASH_REDIS_REST_TOKEN (ไม่บังคับ) ---
# ใช้ทำอะไร: โทเคนเขียน/อ่าน Redis ข้างบน
# หาจากไหน: upstash.com → หน้า Database → แท็บ REST API → UPSTASH_REDIS_REST_TOKEN (ใช้ Token ปกติ ไม่ใช่ Readonly Token)
# ลิงก์: https://console.upstash.com/redis
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ใช้ตัวจำกัดในหน่วยความจำ | production → เหมือนกรณีไม่มี URL
UPSTASH_REDIS_REST_TOKEN=

# --- GOOGLE_SITE_VERIFICATION (ไม่บังคับ) ---
# ใช้ทำอะไร: ยืนยันความเป็นเจ้าของเว็บใน Google Search Console แบบแท็ก HTML (meta google-site-verification) — ไม่ต้องใส่ถ้ายืนยันแบบ Domain ด้วย DNS TXT แล้ว
# หาจากไหน: Search Console → เพิ่ม property แบบ URL prefix → วิธียืนยัน HTML tag → คัดลอกเฉพาะค่าใน content="..."
# ลิงก์: https://search.google.com/search-console
# เปิดเผย: เปิดเผยได้ (ค่านี้ถูกส่งไปถึงเบราว์เซอร์)
# ถ้าไม่ใส่: dev → ไม่มีแท็กยืนยัน | production → ไม่มีแท็กยืนยัน (ใช้การยืนยันแบบ DNS แทนได้)
GOOGLE_SITE_VERIFICATION=

# --- BING_SITE_VERIFICATION (ไม่บังคับ) ---
# ใช้ทำอะไร: ยืนยันความเป็นเจ้าของเว็บใน Bing Webmaster Tools แบบแท็ก HTML (meta msvalidate.01)
# หาจากไหน: bing.com/webmasters → Add site → HTML Meta Tag → คัดลอกเฉพาะค่าใน content="..." (หรือ Import จาก Google Search Console ได้โดยไม่ต้องใช้ค่านี้)
# ลิงก์: https://www.bing.com/webmasters
# เปิดเผย: เปิดเผยได้ (ค่านี้ถูกส่งไปถึงเบราว์เซอร์)
# ถ้าไม่ใส่: dev → ไม่มีแท็กยืนยัน | production → ไม่มีแท็กยืนยัน (ใช้ Import จาก Google แทนได้)
BING_SITE_VERIFICATION=

# --- PROTECTION_MODE (ไม่บังคับ) ---
# ใช้ทำอะไร: ระดับระบบกันดึงโค้ด: strict (ค่าเริ่มต้น) = ด่านฝั่งเซิร์ฟเวอร์ + กันคัดลอก/คีย์ลัด/พิมพ์ + ตรวจ DevTools; relaxed = ไม่ตรวจ DevTools; off = ปิดทั้งหมด (ไฟล์ .map ยังถูกปฏิเสธ) ผู้ดูแลระบบที่ล็อกอินอยู่ไม่โดนการกันฝั่งเบราว์เซอร์เสมอ
# หาจากไหน: ตั้งค่าในโฮสต์ (strict, relaxed หรือ off) แล้ว redeploy
# ลิงก์: https://utdsc.com/th/admin/setup
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → strict | production → strict
PROTECTION_MODE=

# --- DEV_BYPASS_SECRET (ไม่บังคับ) ---
# ใช้ทำอะไร: ทางผ่านของเจ้าของเว็บ: เปิดหน้าใดก็ได้ด้วย ?dev=<ค่านี้> จะได้คุกกี้ HttpOnly อายุ 1 ชั่วโมงที่ข้ามด่านและการกันฝั่งเบราว์เซอร์ทั้งหมด (อย่างน้อย 24 ตัวอักษร)
# หาจากไหน: สร้างเอง เช่น node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" ใส่ในโฮสต์เท่านั้น
# ลิงก์: https://nodejs.org/api/crypto.html#cryptorandombytessize-callback
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ไม่มีทางผ่าน ?dev= | production → ไม่มีทางผ่าน ?dev=
DEV_BYPASS_SECRET=

# --- LIGHTHOUSE_TOKEN (ไม่บังคับ) ---
# ใช้ทำอะไร: กุญแจลับ (อย่างน้อย 32 ตัวอักษร) สำหรับรัน Lighthouse ด้วย scripts/lighthouse.mjs: สคริปต์สร้างโทเคนอายุ 15 นาทีให้ผ่านระบบกันดึงโค้ดได้ ไม่มีการปล่อยผ่านด้วย User-Agent
# หาจากไหน: สร้างเอง เช่น node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))" ใส่ค่าเดียวกันใน .env.local ของเครื่องที่รันสคริปต์ และในโฮสต์
# ลิงก์: https://developer.chrome.com/docs/lighthouse/overview
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → รัน Lighthouse ได้เฉพาะแบบที่ระบบกันดึงโค้ดยอมรับว่าเป็นเบราว์เซอร์ | production → รัน Lighthouse ได้เฉพาะแบบที่ระบบกันดึงโค้ดยอมรับว่าเป็นเบราว์เซอร์
LIGHTHOUSE_TOKEN=

# --- RATE_LIMIT_ALLOW_IPS (ไม่บังคับ) ---
# ใช้ทำอะไร: รายการ IP ที่ไม่ถูกจำกัดจำนวนคำขอของเว็บ (คั่นด้วยจุลภาค รองรับ IPv4/IPv6 และ CIDR เช่น 203.0.113.7,2001:db8::/48) — ยังผ่านการกันบอท การแบน และ Cloudflare ตามปกติ
# หาจากไหน: ล็อกอินเป็นผู้ดูแลระบบแล้วเปิด /api/admin/whoami ค่า ip คือ IP ที่เซิร์ฟเวอร์เห็น
# ลิงก์: https://utdsc.com/api/admin/whoami
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ทุก IP ถูกจำกัดตามปกติ | production → ทุก IP ถูกจำกัดตามปกติ (ผู้ดูแลระบบที่ล็อกอินอยู่ไม่ถูกจำกัดอยู่แล้ว)
RATE_LIMIT_ALLOW_IPS=

# --- NEXT_PUBLIC_TURNSTILE_SITE_KEY (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: คีย์สาธารณะของ Cloudflare Turnstile (กล่องยืนยันว่าไม่ใช่บอท) บนฟอร์มส่งเสียงถึงสภา
# หาจากไหน: dash.cloudflare.com → Turnstile → Add widget → ใส่โดเมนเว็บ → Site Key — ทดสอบได้ด้วยคีย์ 1x00000000000000000000AA (ผ่านเสมอ)
# ลิงก์: https://dash.cloudflare.com/?to=/:account/turnstile
# เปิดเผย: เปิดเผยได้ (ค่านี้ถูกส่งไปถึงเบราว์เซอร์)
# ถ้าไม่ใส่: dev → ไม่แสดงกล่องยืนยัน | production → ไม่แสดงกล่องยืนยัน และฟอร์มส่งไม่ผ่าน
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- TURNSTILE_SECRET_KEY (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: คีย์ลับของ Turnstile ใช้ตรวจผลยืนยันฝั่งเซิร์ฟเวอร์
# หาจากไหน: dash.cloudflare.com → Turnstile → widget ที่สร้าง → Secret Key — คีย์ทดสอบ 1x0000000000000000000000000000000AA (ผ่านเสมอ)
# ลิงก์: https://dash.cloudflare.com/?to=/:account/turnstile
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ข้ามการตรวจ | production → ปฏิเสธทุกการส่ง (fail closed)
TURNSTILE_SECRET_KEY=

# --- ALLOWED_EMAIL_DOMAIN (ไม่บังคับ) ---
# ใช้ทำอะไร: โดเมนอีเมลที่ล็อกอินหลังบ้านได้ (บัญชี Google ของโรงเรียน)
# หาจากไหน: โดเมนอีเมลโรงเรียน ค่าเริ่มต้น utd.ac.th — ใส่เฉพาะเมื่อต้องการเปลี่ยน
# ลิงก์: https://admin.google.com/
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ใช้ utd.ac.th | production → ใช้ utd.ac.th
ALLOWED_EMAIL_DOMAIN=utd.ac.th

# --- COUNCIL_EMAILS (ไม่บังคับ) ---
# ใช้ทำอะไร: บัญชีล็อกอินหลังบ้านบทบาท "สภานักเรียน" (คั่นด้วยจุลภาค, ต่อท้าย :shared ถ้าเป็นบัญชีที่ใช้ร่วมกันหลายคน) ใช้ตอนรัน node scripts/seed-allowed-users.mjs เพื่อใส่ลงตาราง allowed_users ครั้งแรก หลังจากนั้นจัดการที่หน้า /admin/users
# หาจากไหน: รายชื่ออีเมลบัญชีสภานักเรียนจากผู้ดูแล (ห้ามใส่ในไฟล์ที่ commit) — ไม่ต้องตั้งบน Vercel
# ลิงก์: https://admin.google.com/
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ไม่เพิ่มบัญชีอัตโนมัติ (เพิ่มเองที่ /admin/users ได้) | production → ไม่มีผล — แอปอ่านสิทธิ์จากตาราง allowed_users
COUNCIL_EMAILS=

# --- ADMIN_EMAILS (จำเป็นตอนใช้งานจริง) ---
# ใช้ทำอะไร: อีเมลผู้ดูแลระบบ (คั่นด้วย ,) — ได้สิทธิ์ admin ทันที และเป็นข้อยกเว้นเดียวที่ล็อกอินได้แม้ไม่ใช่โดเมนโรงเรียน (ต้องเป็นอีเมลที่ Google ยืนยันแล้ว)
# หาจากไหน: ใส่อีเมล Google ของผู้ดูแลเอง เช่น admin1@utd.ac.th,someone@gmail.com — เอาออกจากรายการ = ถอนสิทธิ์ทันที
# ลิงก์: https://supabase.com/dashboard/project/_/auth/users
# เปิดเผย: ห้ามเปิดเผย / ห้าม commit / ห้ามส่งในแชท
# ถ้าไม่ใส่: dev → ไม่มีใครเป็น admin | production → ไม่มีใครเป็น admin — ตั้งสิทธิ์คนอื่น/ปีการศึกษาไม่ได้
ADMIN_EMAILS=admin1@utd.ac.th,someone@example.com

# --- Google OAuth (ไม่ใช่ค่าใน .env — ตั้งใน Supabase) ---
# ใช้ทำอะไร: ล็อกอินด้วย Google (ไม่ใช่ค่าใน .env — ตั้งที่ Supabase)
# วิธีตั้ง: 1) console.cloud.google.com → APIs & Services → Credentials → Create credentials → OAuth client ID → Web application → Authorized redirect URI: https://<project>.supabase.co/auth/v1/callback  2) supabase.com → Authentication → Sign In / Providers → Google → เปิด แล้วใส่ Client ID + Client Secret  3) Authentication → URL Configuration → Site URL = NEXT_PUBLIC_SITE_URL และเพิ่ม <SITE_URL>/auth/callback ใน Redirect URLs
# ถ้าไม่ตั้ง: ปุ่มเข้าสู่ระบบใช้ไม่ได้
